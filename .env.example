# Copia a .env y asigna secretos largos y aleatorios antes de iniciar Compose.
POSTGRES_DB=innova_c2
POSTGRES_USER=innova
POSTGRES_PASSWORD=
SESSION_SECRET=
BACKUP_ENCRYPTION_KEY=
APP_PORT=8080

# true en producción tras instalar HTTPS; false solo para la instalación local inicial.
COOKIE_SECURE=false
# Actívalo únicamente tras un proxy inverso que elimine/reemplace X-Forwarded-*.
TRUST_PROXY=0
LOG_LEVEL=info

# Correo institucional: permanece desactivado hasta verificar dominio y DNS.
EMAIL_ENABLED=false
# Introducir ambos valores solo en el almacén seguro de secretos del servidor.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
