{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "test:phase0": "pnpm --filter @workspace/api-server run build && node scripts/test-phase0.mjs",
    "test:phase1": "pnpm --filter @workspace/api-server run build && node scripts/test-phase1.mjs",
    "test:phase2": "pnpm --filter @workspace/api-server run build && node scripts/test-phase2.mjs",
    "test:phase3": "pnpm --filter @workspace/api-server run build && node scripts/test-ciclope.mjs",
    "test:spaces": "pnpm --filter @workspace/api-server run build && node scripts/test-spaces.mjs",
    "test:products": "pnpm --filter @workspace/api-server run build && node scripts/test-spaces.mjs --products-only",
    "test:navigation": "node scripts/test-navigation.mjs",
    "test:phase3b": "pnpm --filter @workspace/api-server run build && node scripts/test-mail.mjs && node scripts/test-ciclope.mjs",
    "test:clamav": "node scripts/test-clamav.mjs",
    "test:ai-provider-check": "node scripts/test-ai-provider-check.mjs",
    "test:password-reset": "node scripts/run-password-reset-test.mjs",
    "test:migrations": "node scripts/test-migrations.mjs",
    "test:school-cycle": "pnpm --filter @workspace/api-server run build && node scripts/test-course-cache.mjs && node scripts/test-school-cycle.mjs",
    "test:pic-followups": "pnpm --filter @workspace/api-server run build && node scripts/test-pic-followups.mjs",
    "test:school-cycle-backup": "pnpm --filter @workspace/api-server run build && node scripts/test-school-cycle.mjs --backup-restore",
    "test:password-change": "pnpm --filter @workspace/api-server run build && node scripts/test-password-change.mjs",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
